{
 "format": "emergence-project/1",
 "documents": {
  "project": {
   "name": "Inspection quadcopter",
   "summary": "An 8 kg-class inspection quadcopter across eight domains. Mass sets thrust, thrust sets the ESC current, the current heats the power MOSFET and sizes its heat sink, and the sink is mass again: the weight spiral closes through the solver. Rotor wake cools the ESC, mission altitude sets the camera's ground sample distance, and battery chargers heat the hangar.",
   "domains": [
    "flight",
    "mech",
    "parts",
    "pcb",
    "silicon",
    "optics",
    "fluids",
    "architecture"
   ],
   "headline": [
    {
     "port": "flight.total_mass",
     "label": "Take-off mass"
    },
    {
     "port": "flight.flight_time",
     "label": "Hover endurance"
    },
    {
     "port": "mech.q1_tj",
     "label": "ESC MOSFET junction"
    },
    {
     "port": "flight.esc_current",
     "label": "Design ESC current"
    },
    {
     "port": "optics.gsd",
     "label": "Ground sample distance"
    },
    {
     "port": "silicon.power",
     "label": "Flight-controller die"
    },
    {
     "port": "architecture.room_temperature",
     "label": "Charging room"
    },
    {
     "port": "fluids.duct_velocity",
     "label": "ESC cooling air"
    }
   ],
   "studies": [

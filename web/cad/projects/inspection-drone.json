    }
   ],
   "optimize": {
    "title": "Close the weight spiral",
    "summary": "Lightest take-off mass with the ESC MOSFET junction at or below 100 °C and every linked model inside its validated range. Each trial is a full coupled solve.",
    "objective": {
     "port": "flight.total_mass",
     "sense": "min"
    },
    "constraints": [
     {
      "port": "mech.q1_tj",
      "max": 100,
      "label": "ESC MOSFET junction ≤ 100 °C"
     }
    ],
    "variables": [
     {
      "domain": "mech",
      "path": "params.fins",
      "label": "Fin count",
      "min": 5,
      "max": 14,
      "step": 1,
      "integer": true
     },
     {
      "domain": "mech",
      "path": "params.finHeight",
      "label": "Fin height",
      "min": 10,
      "max": 35,
      "step": 0.5
     },
     {
      "domain": "mech",
      "path": "params.length",
      "label": "Sink length",
      "min": 30,
      "max": 90,
      "step": 0.5
     }
    ],
    "trials": 40
   },
   "tour": [
    {
     "studio": "system",
     "title": "One drone, eight domains, one solve",
     "text": "This project is one file: eight design documents, the links between them and this tour. Mass sets thrust, thrust sets the ESC current, the current heats Q1 and sizes the sink, and the sink is mass again. The solver iterates that loop until it settles and says so."
    },
    {
     "studio": "flight",
     "title": "Carry a heavier camera",
     "text": "A bigger gimbal raises take-off mass. Watch the design-point ESC current, the MOSFET junction temperature and the hover endurance move together.",
     "command": "flight.mass gimbal 1.6",
     "watch": [
      "flight.total_mass",
      "flight.esc_current",
      "mech.q1_tj",
      "flight.flight_time"
     ]
    },
    {
     "studio": "mechanical",
     "title": "Trim the ESC heat sink",
     "text": "Fewer fins weigh less, which helps every motor. The Rust electrothermal graph re-solves the sink, and the fluids studio re-solves the duct with the wider channels.",
     "command": "mech.set fins 6",
     "watch": [
      "mech.sink_mass",
      "fluids.duct_velocity",
      "mech.q1_tj"
     ],
     "checks": [
      "mech/REQ-TJ"
     ]
    },
    {
     "studio": "pcb",
     "title": "Route the ESC board",
     "text": "The router finds clear paths on the snap grid, around other nets' copper. The kernel then computes each trace's resistance from its drawn length, and the load current from Flight sets the I²R loss.",
     "command": "pcb.route_all width=0.6",
     "watch": [
      "pcb.unrouted",
      "pcb.copper_loss"
     ],
     "checks": [
      "pcb/density"
     ]
    },
    {
     "studio": "silicon",
     "title": "Clock the flight controller faster",
     "text": "The RTL is synthesized onto transistor-characterised cells and timed across nine corners at the die's own junction temperature. Faster clocks cost power and slack.",
     "command": "silicon.chip frequency=400",
     "watch": [
      "silicon.power",
      "silicon.junction"
     ],
     "checks": [
      "silicon/setup-cpu"
     ]
    },
    {
     "studio": "optics",
     "title": "Fly higher for coverage",
     "text": "Mission altitude is a Flight output linked into the camera. The Cooke triplet's focal length and the sensor pixel set the ground sample distance.",
     "command": "flight.set altitude=150",
     "watch": [
      "optics.gsd"
     ],
     "checks": [
      "optics/gsd"
     ]
    },
    {
     "studio": "fluids",
     "title": "Scoop more rotor wake",
     "text": "More of the downwash's dynamic pressure drives the ESC duct. Past Re 2300 the fin channels leave the laminar correlation, and the mechanical model refuses to extrapolate instead of guessing.",
     "command": "flight.set capture=0.3",
     "watch": [
      "flight.wake_pressure",
      "fluids.duct_velocity"
     ],
     "checks": [
      "mech/REQ-TJ"
     ]
    },
    {
     "studio": "architecture",
     "title": "Charge more packs in the hangar",
     "text": "Each charger dissipates the pack energy's 8% loss over a one-hour charge. The charging room uses the BESTEST 600 envelope; its supply air sets its temperature.",
     "command": "architecture.site units=14",
     "watch": [
      "architecture.equipment_load",
      "architecture.room_temperature"
     ],
     "checks": [
      "architecture/room"
     ]
    },
    {
     "studio": "system",
     "title": "Everything above was a command",
     "text": "Each step ran through the same registry the command line, scripts, the CLI and the MCP server use. End the tour to restore your design exactly as it was."
    }
   ],

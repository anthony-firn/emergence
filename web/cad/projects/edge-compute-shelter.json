{
 "format": "emergence-project/1",
 "documents": {
  "project": {
   "name": "Edge compute shelter",
   "summary": "A roadside shelter of accelerator nodes. Every node's heat goes into the shelter, and the shelter's air is every node's inlet: die leakage, the VRM MOSFET and the fan duct all run at the room temperature they create. The coupled loop runs through silicon, PCB, mechanical, fluids and architecture; the question is how many nodes fit.",
   "domains": [
    "mech",
    "parts",
    "pcb",
    "silicon",
    "fluids",
    "architecture"
   ],
   "headline": [
    {
     "port": "architecture.room_temperature",
     "label": "Shelter air"
    },
    {
     "port": "architecture.equipment_load",
     "label": "IT heat in the shelter"
    },
    {
     "port": "silicon.junction",
     "label": "Accelerator junction"
    },
    {
     "port": "silicon.power",
     "label": "Accelerator die power"
    },
    {
     "port": "mech.q1_tj",
     "label": "VRM MOSFET junction"
    },
    {
     "port": "fluids.flow",
     "label": "Node fan flow"
    }
   ],
   "studies": [
    {
     "id": "nodes",
     "label": "Nodes in the shelter",
     "domain": "architecture",
     "path": "units"
    },
    {
     "id": "supply",
     "label": "Shelter supply air",
     "domain": "architecture",
     "path": "rooms.room.supply"
    },
    {
     "id": "outdoor",
     "label": "Outdoor temperature",
     "domain": "architecture",
     "path": "site.outdoor"
    },
    {
     "id": "npu",
     "label": "Tensor-array power",
     "domain": "silicon",
     "path": "blocks.npu.power"
    },
    {
     "id": "clock",
     "label": "Accelerator clock",
     "domain": "silicon",
     "path": "chip.frequency"
    },
    {
     "id": "vrm-current",
     "label": "VRM phase current",
     "domain": "mech",
     "path": "params.current",
     "max": 40
    },
    {
     "id": "fins",
     "label": "VRM sink fin height",
     "domain": "mech",
     "path": "params.finHeight",
     "max": 35
    }
   ],
   "optimize": {
    "title": "Fill the shelter",
    "summary": "Most nodes in the shelter with the air at or below its limit, the VRM MOSFET at or below 100 °C and the accelerator junction at or below 95 °C. Each trial is a full coupled solve.",
    "objective": {
     "port": "architecture.equipment_load",
     "sense": "max"
    },
    "constraints": [
     {
      "port": "architecture.room_temperature",
      "max": 35,
      "label": "Shelter air ≤ 35 °C"
     },
     {
      "port": "mech.q1_tj",
      "max": 100,
      "label": "VRM MOSFET ≤ 100 °C"
     },
     {
      "port": "silicon.junction",
      "max": 95,
      "label": "Accelerator junction ≤ 95 °C"
     }
    ],
    "variables": [
     {
      "domain": "architecture",
      "path": "units",
      "label": "Nodes",
      "min": 1,
      "max": 200,
      "step": 1,
      "integer": true
     }
    ],
    "trials": 40
   },
   "tour": [
    {
     "studio": "system",
     "title": "A building that heats its own machines",
     "text": "This project is a different file from the drone, solved by the same system. Each accelerator node sends its die, VRM and board heat into the shelter; the shelter's air temperature comes back as every node's inlet. The solver iterates that loop until it settles."
    },
    {
     "studio": "architecture",
     "title": "Add eight more nodes",
     "text": "More nodes means more heat in the same supply air. Watch the shelter warm, and the warmer inlet raise the accelerator's leakage and the VRM MOSFET's temperature.",
     "command": "architecture.site units=32",
     "watch": [
      "architecture.equipment_load",
      "architecture.room_temperature",
      "silicon.junction",
      "mech.q1_tj"
     ],
     "checks": [
      "architecture/room"
     ]
    },
    {
     "studio": "silicon",
     "title": "Clock the accelerator faster",
     "text": "The control CPU and fan PWM blocks are synthesised from public RTL and timed at the die's own junction temperature, which now depends on the shelter.",
     "command": "silicon.chip frequency=200",
     "watch": [
      "silicon.power",
      "silicon.junction",
      "architecture.room_temperature"
     ],
     "checks": [
      "silicon/setup-cpu"
     ]
    },
    {
     "studio": "mechanical",
     "title": "Load the VRM harder",
     "text": "The core-rail phase current heats the VRM MOSFET; its heat sink sits in the node's fan duct, and both its loss and the board's copper loss go into the shelter.",
     "command": "mech.set current 36",
     "watch": [
      "mech.q1_power",
      "mech.q1_tj",
      "pcb.copper_loss"
     ],
     "checks": [
      "mech/REQ-TJ"
     ]
    },
    {
     "studio": "system",
     "title": "Same system, different project",
     "text": "Nothing here is specific to drones or shelters: domains, links, studies, the optimiser and this tour all come from the project file. End the tour to restore the design."
    }
   ],
